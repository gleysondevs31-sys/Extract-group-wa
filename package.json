{
  "name": "whatsapp-baileys-render-admin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts dev",
    "build": "prisma generate && next build && tsc -p tsconfig.server.json",
    "start": "prisma generate && npm run db:push && next build && tsx server.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "render:build": "npm ci && npm run build",
    "render:start": "npm run start",
    "serve": "node dist/server.js",
    "db:push": "if [ -n \"$DATABASE_URL\" ]; then prisma db push; else echo \"DATABASE_URL not set; skipping prisma db push\"; fi"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@hookform/resolvers": "^5.0.1",
    "@prisma/client": "^6.9.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-table": "^8.21.3",
    "baileys": "7.0.0-rc.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^1.0.2",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^7.2.0",
    "lucide-react": "^0.468.0",
    "next": "15.3.6",
    "next-themes": "^0.4.6",
    "pino": "^9.7.0",
    "qrcode-terminal": "^0.12.0",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "react-hook-form": "^7.57.0",
    "sonner": "^2.0.5",
    "tailwind-merge": "^2.6.0",
    "tsx": "^4.19.4",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.29",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.28.0",
    "eslint-config-next": "15.3.6",
    "postcss": "^8.5.6",
    "prisma": "^6.9.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": "22.x"
  }
}
